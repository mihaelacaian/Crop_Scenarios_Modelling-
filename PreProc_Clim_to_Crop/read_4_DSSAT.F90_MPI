       program read_4_DSSAT
       implicit none
       character(len=10) :: exper
       character(len=4) ::  clexper
       integer :: y2,  ys,ye,ms,me,ds,de,freq,ndx,ndxx,im
       parameter(ndxx=100*366)
       integer d4,d4yy,ie,ir4,ntx,it,itd,idat29
       real loclon,loclat, locelev, locav, locamp,locrefth, locwndht
       integer ilocelev
       real undeff
       parameter(undeff=-99.)
       real rad(ndxx), tmax(ndxx), tmin(ndxx), prec(ndxx), td(ndxx)
       real wind(ndxx), par(ndxx),evap(ndxx),rh(ndxx)
       integer idat(ndxx)
       integer djant,dfeb, dfebt, dmart,daprt,dmayt,djunt
       integer djult,daugt,dsept,doctt,dnovt,ddect
       integer idat31jan, idat29feb, idat31jul,&
     &         idat31aug,idat31oct,idat31dec
       character cly2*5
       namelist /namexp / exper,clexper,  ys,ye,ds,de,ms,me,ndx,&
     &                    freq,loclon,loclat,locelev
!
        rad(:)=undeff
        tmax(:)=undeff
        tmin(:)=undeff
        prec(:)=undeff
        td(:)=undeff
        wind(:)=undeff
        par(:)=undeff
        evap(:)=undeff
        rh(:)=undeff

         locelev=undeff
         locamp=undeff
         locrefth=undeff
         locav=undeff
         locwndht=undeff
!
 
        open(65,file='fa_tmax',form='formatted') 
        open(66,file='fa_tmin',form='formatted') 
        open(67,file='fa_rain',form='formatted') 
        open(68,file='fa_dewp',form='formatted') 

        open(80,file='faout.txt',form='formatted') 

        open(4,file='namelist_descr.txt')
        read(nml=namexp,unit=4)


! cate grupe de cate 4 ani avem intre ye si y2, inclusiv        
! cati ani cu 366 ! zile avem intre ys si ye, inclusiv   

        if(ye.ne.ys) then
         print*,'ERROR: ys .ne. ys'
         stop
        endif


        d4yy=0
        d4=(ys)/4 
        ir4=ys-ys/4*4
        y2=(ys-ys/100*100)*1000 
         if(ir4.eq.0) then
         d4yy=1
         endif


         ntx=365*freq+d4yy*freq
         print*,'freq=',freq,'d4yy=',d4yy,'NTX=', ntx, "year=", ys
         djant=31

         djant=1*30
         dfebt=1*30+28
         idat29feb=y2+30+28
         djult=7*30
         daugt=8*30
         doctt=10*30
         ddect=12*30


         do it=1,ntx
          idat(it)=y2+it
          print*,'IDAT=', idat(it)
         enddo
         
!
         write(80,'(a31)') '*WEATHER DATA : Grid cell 00001'
         write(80,'(a6,6x,a3,8x,a4,4x,a4,2x,a3,5x,a3,3x,a5,3x,a5)') &
     &  '@INSI','LAT','LONG','ELEV','TAV','AMP'

         write(80,&
     &'(2x,a4,2x,f9.3,2x,f9.3,2x,i4,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1)') &
     &             clexper, loclat, loclon, int(locelev), locav, locamp,&
     &   locrefth, locwndht

           write(33,'(f5.1)') locav
           print*,'locav=',locav

         write(80,'(a6,2x,a4,3x,a4,3x,a4,3x,a4,3x,a4,3x,&
     &  a4,2x,a4,4x,a4,3x,a4)') &
     &  '@DATE', 'SRAD','TMAX', 'TMIN','RAIN',&
     &   'DEWP','WIND','PAR','EVAP','RHUM'
  
! 
         do it=1,ndx
          read(65,*) tmax(it)
          read(66,*) tmin(it)
          read(67,*) prec(it)
          read(68,*) td(it)
         enddo



         itd=0
         do it=1,ndx
          itd=itd+1
         write(80,'(I5,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,&
     &f5.1,2x,f5.1,2x,f5.1,2x,f5.1)')&
     &     idat(itd),rad(it),tmax(it),tmin(it),prec(it),td(it),&
     &     wind(it),par(it),evap(it),rh(it) 
!!!!!!!!!!!!!!!!!!!!!!!!
! bisect year day
!!!!!!!!!!!!!!!!!!!!!!!!
! mohc add 5 days first
          if(it.eq.djant) then
           idat31jan=y2+31 
         write(80,'(I5,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,&
     &f5.1,2x,f5.1,2x,f5.1,2x,f5.1)')&
     &     idat31jan,rad(it),tmax(it),tmin(it),prec(it),td(it),&
     &     wind(it),par(it),evap(it),rh(it) 
           itd=itd+1
!!!!!!!!!!!!!!!!!!!!!!!!
            elseif(ir4.eq.0.and.it.eq.dfebt)  then
             idat29feb=y2+(31+28)+1
         write(80,'(I5,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,&
     &f5.1,2x,f5.1,2x,f5.1,2x,f5.1)')&
     &     idat29feb,rad(it),tmax(it),tmin(it),prec(it),td(it),&
     &     wind(it),par(it),evap(it),rh(it) 
           itd=itd+1
!!!!!!!!!!!!!!!!!!!!!!!!
              elseif(it.eq.djult) then
             idat31jul=y2+(31+(30+d4yy)+30+30+30+30+30)+1
         write(80,'(I5,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,&
     &f5.1,2x,f5.1,2x,f5.1,2x,f5.1)')&
     &     idat31jul,rad(it),tmax(it),tmin(it),prec(it),td(it),&
     &     wind(it),par(it),evap(it),rh(it) 
           itd=itd+1
!!!!!!!!!!!!!!!!!!!!!!!!
             elseif(it.eq.daugt) then
             idat31aug=idat31jul+30+1
         write(80,'(I5,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,&
     &f5.1,2x,f5.1,2x,f5.1,2x,f5.1)')&
     &     idat31aug,rad(it),tmax(it),tmin(it),prec(it),td(it),&
     &     wind(it),par(it),evap(it),rh(it) 
           itd=itd+1
!!!!!!!!!!!!!!!!!!!!!!!!
            elseif(it.eq.doctt) then
             idat31oct=idat31aug+30+30+1
         write(80,'(I5,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,&
     &f5.1,2x,f5.1,2x,f5.1,2x,f5.1)')&
     &     idat31oct,rad(it),tmax(it),tmin(it),prec(it),td(it),&
     &     wind(it),par(it),evap(it),rh(it) 
           itd=itd+1
!!!!!!!!!!!!!!!!!!!!!!!!
            elseif(it.eq.ddect) then
             idat31dec=idat31oct+30+30+1
         write(80,'(I5,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,f5.1,2x,&
     &f5.1,2x,f5.1,2x,f5.1,2x,f5.1)')&
     &     idat31dec,rad(it),tmax(it),tmin(it),prec(it),td(it),&
     &     wind(it),par(it),evap(it),rh(it) 
           itd=itd+1
!!!!!!!!!!!!!!!!!!!!!!!!
           endif
!!!!!!!!!!!!!!!!!!!!!!!!
          print*, "year=", ys,"IT=", it, "ITD=", itd
          print*, "idat31jan,29feb,31jul,31aug,31oct,31dec=", &
     & idat31jan,idat29feb,idat31jul,idat31aug,idat31oct,idat31dec
         enddo
          print*, "year=", ys, "ITD_final=", itd,"IT_final=",it, "ir4=", ir4
          print*,'ilocelev=',int(locelev), 'locelev=', locelev
         stop
         end
